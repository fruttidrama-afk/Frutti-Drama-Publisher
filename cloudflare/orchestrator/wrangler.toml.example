name = "publisher-factory-orchestrator"
main = "src/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

[triggers]
crons = ["*/5 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "publisher-factory"
database_id = "REPLACE_AFTER_D1_CREATE"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "publisher-factory-media"

[vars]
GITHUB_REPO = "fruttidrama-afk/Frutti-Drama-Publisher"
GITHUB_WORKFLOW = "free-runtime-runner.yml"
GITHUB_REF = "main"
LEASE_MINUTES = "45"
