{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher-factory.local/schemas/publisher-config-v1.json",
  "title": "Publisher Config V1",
  "type": "object",
  "required": [
    "runtime_version",
    "identity",
    "content",
    "generation",
    "automation",
    "review",
    "schedule",
    "publication",
    "security",
    "knowledge"
  ],
  "properties": {
    "runtime_version": {
      "const": "publisher-runtime-v1"
    },
    "identity": {
      "type": "object",
      "required": [
        "publisher_name",
        "show_name",
        "language",
        "timezone"
      ],
      "properties": {
        "publisher_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "show_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "language": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        },
        "content_category": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "serialized",
        "videos_per_day",
        "creative_bible"
      ],
      "properties": {
        "serialized": {
          "type": "boolean"
        },
        "videos_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "creative_bible": {
          "type": "string"
        },
        "episode_structure": {
          "type": "string"
        },
        "dialogue": {
          "type": "boolean"
        },
        "voice_language": {
          "type": "string"
        },
        "visual_style": {
          "type": "string"
        },
        "continuity_gate": {
          "enum": [
            "review_ready",
            "approved",
            "published",
            "none"
          ],
          "default": "approved"
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role_rules"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "flow_saved_name": {
            "type": "string"
          },
          "mention": {
            "type": "string"
          },
          "role_rules": {
            "type": "array",
            "items": {
              "enum": [
                "ON_SCREEN",
                "OFF_SCREEN",
                "MENTIONED",
                "WRITTEN_REFERENCE",
                "DECEASED_REFERENCE",
                "PHOTO",
                "FLASHBACK",
                "VOICE_ONLY",
                "PROP_REFERENCE"
              ]
            }
          },
          "visual_rules": {
            "type": "string"
          },
          "voice_rules": {
            "type": "string"
          },
          "canon_metadata": {
            "type": "string"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "provider",
        "model_intent",
        "duration_seconds",
        "aspect_ratio",
        "output_count",
        "daily_credit_grant",
        "automatic_batch_credit_gate",
        "credit_refresh_poll_minutes",
        "credit_refresh_guard_hours",
        "credit_refresh_fallback_hours"
      ],
      "properties": {
        "provider": {
          "const": "google-flow"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_intent": {
          "type": "string"
        },
        "resolution_intent": {
          "type": "string"
        },
        "download_quality": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "aspect_ratio": {
          "type": "string"
        },
        "output_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "credits_per_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "daily_credit_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "daily_credit_grant": {
          "const": 50
        },
        "automatic_batch_credit_gate": {
          "const": "wait-for-daily-flow-refresh"
        },
        "credit_refresh_poll_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 5
        },
        "credit_refresh_guard_hours": {
          "type": "number",
          "minimum": 6,
          "maximum": 28,
          "default": 20
        },
        "credit_refresh_fallback_hours": {
          "type": "number",
          "minimum": 21,
          "maximum": 48,
          "default": 30
        }
      }
    },
    "automation": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "free-browser-provider"
        },
        "persistent_profile": {
          "const": true
        },
        "tinyfish_required": {
          "const": false
        },
        "semantic_field_safety": {
          "const": true
        },
        "external_reality_reconciliation": {
          "const": true
        },
        "redo_exactly_once": {
          "const": true
        },
        "redo_token_persistent": {
          "const": true
        },
        "semantic_redo_interpretation": {
          "const": true
        },
        "post_submit_timeout_resubmit": {
          "const": false
        },
        "render_identity_binding": {
          "enum": [
            "unique-post-baseline-result"
          ]
        },
        "flow_sop_version": {
          "const": "FLOW-SOP-v1.0"
        },
        "flow_sop_sha256": {
          "const": "8172f4b415e516fb1ec211a338ef7872740d7931adfbc5ab31572344a5bc9162"
        },
        "inherit_flow_sop": {
          "const": true
        },
        "exactly_once_submit": {
          "const": true
        },
        "strict_serial_generation": {
          "const": true
        },
        "project_grid_recovery": {
          "const": true
        },
        "current_consent_only": {
          "const": true
        },
        "review_metadata_required": {
          "const": true
        },
        "golden_test_required": {
          "const": true
        }
      },
      "required": [
        "provider",
        "persistent_profile",
        "tinyfish_required",
        "semantic_field_safety",
        "external_reality_reconciliation",
        "redo_exactly_once",
        "redo_token_persistent",
        "semantic_redo_interpretation",
        "post_submit_timeout_resubmit",
        "render_identity_binding",
        "flow_sop_version",
        "flow_sop_sha256",
        "inherit_flow_sop",
        "exactly_once_submit",
        "strict_serial_generation",
        "project_grid_recovery",
        "current_consent_only",
        "review_metadata_required",
        "golden_test_required"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "review",
            "auto_publish"
          ]
        },
        "archive_provider": {
          "const": "local-only",
          "description": "Unapproved review media must remain on the Publisher's private persistent volume."
        },
        "external_storage_before_approval": {
          "const": false
        },
        "approval_required_before_publication": {
          "const": true
        },
        "reject_purges_external_artifacts": {
          "const": true
        },
        "hot_originals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "archive_below_free_percent": {
          "type": "number",
          "minimum": 1,
          "maximum": 95
        },
        "redo_requires_feedback": {
          "const": true
        },
        "redo_returns_to_review": {
          "const": true
        }
      }
    },
    "schedule": {
      "type": "object",
      "required": [
        "timezone",
        "indefinite",
        "generation_strategy",
        "posting_times",
        "upload_lead_minutes"
      ],
      "properties": {
        "timezone": {
          "type": "string"
        },
        "indefinite": {
          "const": true
        },
        "generation_strategy": {
          "const": "sequential"
        },
        "posting_times": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upload_lead_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440,
          "description": "Provider-specific lead time. YouTube defaults to 390 minutes; Facebook Reels may publish at the scheduled runtime moment."
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "providers",
        "daily_publication_target"
      ],
      "properties": {
        "allowed_providers": {
          "type": "array",
          "items": {
            "enum": [
              "youtube",
              "facebook"
            ]
          }
        },
        "selected_provider": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "youtube",
            "facebook",
            null
          ]
        },
        "daily_publication_target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1
        },
        "providers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "privacy_before_publish",
                  "release_mode",
                  "use_publish_at",
                  "metadata_final_before_upload",
                  "preserve_private_lead_window",
                  "upload_lead_minutes",
                  "contains_synthetic_media"
                ],
                "properties": {
                  "type": {
                    "const": "youtube"
                  },
                  "privacy_before_publish": {
                    "const": "private"
                  },
                  "playlist_strategy": {
                    "type": "string"
                  },
                  "title_rules": {
                    "type": "string"
                  },
                  "description_rules": {
                    "type": "string"
                  },
                  "hashtags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "contains_synthetic_media": {
                    "const": true
                  },
                  "release_mode": {
                    "const": "private_then_public_at_posting_time"
                  },
                  "use_publish_at": {
                    "const": false
                  },
                  "metadata_final_before_upload": {
                    "const": true
                  },
                  "preserve_private_lead_window": {
                    "const": true
                  },
                  "upload_lead_minutes": {
                    "const": 390
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "contains_synthetic_media"
                ],
                "properties": {
                  "type": {
                    "const": "facebook"
                  },
                  "hashtags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "upload_lead_minutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440
                  },
                  "contains_synthetic_media": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "passkeys": {
          "const": true
        },
        "recovery_pin": {
          "type": "boolean"
        },
        "session_management": {
          "const": true
        }
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "reference_mode": {
          "enum": [
            "web_design",
            "show_reference"
          ]
        },
        "reference_image_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_reference_image": {
          "type": "boolean"
        },
        "reference_usage": {
          "type": [
            "string",
            "null"
          ]
        },
        "logo_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "logo_source": {
          "enum": [
            "uploaded",
            "generated"
          ]
        },
        "icon_180_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon_192_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon_512_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "maskable_icon_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "safe_area_ratio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.9
        },
        "theme": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "background": {
              "type": "string"
            },
            "surface": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "required": [
        "flow_sop_version",
        "flow_sop_sha256",
        "inherit",
        "files"
      ],
      "properties": {
        "flow_sop_version": {
          "const": "FLOW-SOP-v1.0"
        },
        "flow_sop_sha256": {
          "const": "8172f4b415e516fb1ec211a338ef7872740d7931adfbc5ab31572344a5bc9162"
        },
        "inherit": {
          "const": true
        },
        "files": {
          "type": "array",
          "minItems": 8,
          "contains": {
            "const": "GOOGLE_FLOW_AUTOMATION_MASTER_SOP.md"
          }
        }
      }
    }
  }
}
